{
  "name": "that-cat-is-mine-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run server --exclude \"build/**\"",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-local.mjs",
    "check:inventory": "tsx scripts/check-inventory.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.21",
    "@colyseus/ws-transport": "^0.16.5",
    "better-sqlite3": "^12.2.0",
    "colyseus.js": "^0.16.22",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "msgpackr-extract@3.0.7": true
  }
}
